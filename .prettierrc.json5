{
  // JSON Schema 校验地址，用于编辑器自动补全和校验
  $schema: 'https://json.schemastore.org/prettierrc',

  // 单行最大字符数，超出则换行
  printWidth: 100,

  // 缩进空格数
  tabWidth: 2,

  // 使用空格而非 Tab 缩进
  useTabs: false,

  // 语句末尾不加分号
  semi: false,

  // Vue 文件中 <script> 和 <style> 块内容同样缩进
  vueIndentScriptAndStyle: true,

  // 字符串使用单引号
  singleQuote: true,

  // 对象属性名仅在必要时加引号
  quoteProps: 'as-needed',

  // 多行结构（数组/对象等）末尾不加逗号
  trailingComma: 'none',

  // JSX 中结尾 `>` 不放在最后一个属性同行
  jsxBracketSameLine: false,

  // JSX 属性使用双引号（非单引号）
  jsxSingleQuote: false,

  // 箭头函数单参数时省略括号，如 x => x
  arrowParens: 'avoid',

  // 不在文件顶部插入 @format pragma 注释
  insertPragma: false,

  // 对象字面量括号内保留空格，如 { foo: bar }
  bracketSpacing: true,

  // 不要求文件顶部存在 @format pragma 才格式化
  requirePragma: false,

  // Markdown 文字不自动折行
  proseWrap: 'never',

  // HTML 中忽略空白符敏感性，统一压缩处理
  htmlWhitespaceSensitivity: 'ignore',

  // 行尾换行符跟随系统/文件现有风格
  endOfLine: 'auto',

  // 格式化起始字符偏移量（从文件开头开始）
  rangeStart: 0,

  // 格式化结束字符偏移量（到文件末尾）
  rangeEnd: Infinity,
}
